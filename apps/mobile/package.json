{
  "name": "nexvoy-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform all --output-dir dist",
    "build:development:android:local": "node scripts/eas-local-build.mjs --profile development --platform android --local --clear-cache",
    "build:preview:android:local": "node scripts/eas-local-build.mjs --profile preview --platform android --local --clear-cache",
    "build:preview:ios-simulator:local": "node scripts/eas-local-build.mjs --profile preview-simulator --platform ios --local --clear-cache",
    "test:authority": "tsx --test lib/data/server-authority/__tests__/*.test.ts lib/invitations/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@nexvoy/core": "workspace:*",
    "@nexvoy/design-tokens": "workspace:*",
    "@nexvoy/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-picker/picker": "^2.11.1",
    "@supabase/supabase-js": "^2.97.0",
    "expo": "~54.0.36",
    "expo-auth-session": "^7.0.11",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "^1.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "^14.0.12",
    "expo-linking": "~8.0.12",
    "expo-modules-core": "~3.0.30",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "^15.0.11",
    "metro-runtime": "^0.85.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-maps": "^1.20.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native/metro-config": "0.81.5",
    "@types/node": "^20.19.35",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "^54.0.11",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  }
}
